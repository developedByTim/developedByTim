---
import Toolbar from "../components/navigation/Toolbar.astro";
import Layout from "../layouts/Layout.astro";
import LatestImageStack from "../components/react/imageGallery/LatestImageStack";
import LatestVideoStack from "../components/react/movingImages/LatestVideoStack";
import Footer from "../components/navigation/Footer.astro";
---

<Layout title="Developed by Tim">
  <Toolbar />
  <main>
    <div class="intro-text">
      <h1>Visual Narratives</h1>
      <p class="intro-definition text-xl">Light, shadow, and everything in between</p>
    </div>
    <br />
    <div class="home-links">
      <a class="home-link" href="/MovingImages">
        <h3 class="home-link-title">Cinema</h3>
        <span class="home-link-caption">VIDEO WORK</span>
      </a>
      <a class="home-link" href="/Photography">
        <h3 class="home-link-title">Gallery</h3>
        <span class="home-link-caption">FILM PHOTOGRAPHY</span>
      </a>
    </div>

    <!-- <div class="gap-8 m-auto max-w-4xl flex items-center mb-20">
	<div class="">
	 <h2>Putting it all together</h2>
	 <br>
	  
	<p>
		Stories unfolding in subtle ways. Pay close attention so you don't miss a beat. <br/>
		Each piece is slowly revealed by using our senses.
	</p>
	</div>

</div> -->
  </main>
  <Footer />
</Layout>
<style>
  main {
    margin: auto;
    width: 100%;
    max-width: calc(100% - 20rem);
  }

  .intro-text {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  .intro-text h1 {
    animation: reveal-content 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .intro-definition {
    color: var(--text-muted);
    text-transform: uppercase;
    animation: reveal-content 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.18s both;
  }

  .home-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(100%, 52rem);
    margin: 3rem auto 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .home-link {
    color: inherit;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 0;
    padding: 1.75rem 1rem;
    text-align: center;
    animation: reveal-content 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .home-link:first-child {
    animation-delay: 0.42s;
  }

  .home-link:nth-child(2) {
    animation-delay: 0.58s;
  }

  .home-link + .home-link {
    border-left: 1px solid var(--border);
  }

  .home-link-title {
    margin: 0;
    font-family: "Montserrat", sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    transition: transform 0.2s ease;
  }

  .home-link-caption {
    color: var(--text-muted);
    font-family: Arial, sans-serif;
    font-size: 1.25rem;
    line-height: 1.4;
    text-transform: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .home-link:hover .home-link-title,
  .home-link:focus-visible .home-link-title {
    transform: translateY(-2px) scale(1.06);
  }

  .home-link:hover .home-link-caption,
  .home-link:focus-visible .home-link-caption {
    transform: scale(0.94);
    opacity: 0.8;
  }

  h1,
  h2,
  h3,
  p {
    text-transform: uppercase;
  }
  p {
    font-family: Arial, sans-serif;
  }
  h1 {
    font-weight: 600;
    font-family: "Montserrat", sans-serif;
  }
  .video-embed {
    width: 400px;
    aspect-ratio: 4 / 3;
    border: 0;
    pointer-events: none;
  }

  @keyframes reveal-content {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-text h1,
    .intro-definition,
    .home-link {
      animation: none;
    }
  }

  @media (max-width: 768px) {
    main {
      max-width: unset;
      padding: 0 1rem 2rem;
    }

    .home-links {
      grid-template-columns: 1fr;
      border-top: 0;
      border-bottom: 0;
    }

    .home-link + .home-link {
      border-top: 1px solid var(--border);
      border-left: 0;
    }

    .video-embed {
      width: 100%;
      max-width: 400px;
    }
  }
</style>
