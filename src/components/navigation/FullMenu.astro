---
import LoginButton from "../react/login/LoginButton";
import { ThemeToggle } from "../react/UI/ThemeToggle";
import ToolSection from "../react/ToolSection";
import Logo from "./logo.astro";

const { id } = Astro.props;
---

<div
  class="bg-panel shadow-md z-3000 relative border
         w-full md:w-[30rem]
         max-h-screen overflow-y-auto"
  id={id}
>
  <div class="grid grid-cols-2 gap-8 p-6 md:flex md:flex-row md:gap-12">
    <div class="col-span-2 md:col-span-1">
      <span id="closeMenu" class="absolute md:hidden top-5 right-5 text-xl"
        >❌</span
      >
      <h3>Page</h3>
      <ul>
          <li><a href="/Photography">Gallery</a></li>
          <li><a href="/MovingImages">Cinema</a></li>
        <li><a href="/Collections">Collections</a></li>
        <li><a href="/About">About</a></li>
      </ul>
    </div>
    <div class="col-start-1 row-start-2">
      <h3>Info</h3>
      <ul>
       <!-- <li>
  <a href="mailto:mtim6921@gmail.com" class="text-blue-600 hover:underline">
    mtim6921@gmail.com
  </a>
  <button 
    onclick="navigator.clipboard.writeText('mtim6921@gmail.com');" 
    class="ml-2 text-sm text-gray-500 hover:text-gray-700"
    title="Copy email"
  >
    📋
  </button>
</li> -->
        <li class="flex flex-wrap items-center gap-4 text-[24px]">
          <a
            href="https://www.instagram.com/developedbytim/"
            target="_blank"
            class="fa fa-instagram"></a>
          <a
            href="https://www.facebook.com/timur.muedinov.9"
            target="_blank"
            class="fa fa-facebook"></a>
          <a
            href="https://www.youtube.com/channel/UConQOmFJoqkLsz7pBqtapIw/"
            target="_blank"
            class="fa fa-youtube"></a>
          <a
            href="https://www.linkedin.com/in/timur-muedinov-4a8990152/"
            target="_blank"
            class="fa fa-linkedin"></a>
        </li>
      </ul>
    </div>
    <div class="col-span-2 row-start-3 md:col-auto md:row-auto">
      <ToolSection client:load />
    </div>
    <div class="col-start-2 row-start-2">
      <h3>Appearance</h3>
      <div class="theme-toggle-wrap">
        <ThemeToggle client:load />
      </div>
    </div>
  </div>
  <footer
    class="border-t p-4 flex flex-col gap-4"
  >
    <div class="flex flex-col items-start gap-4 md:flex-row md:gap-8">
      <a href="/License">License</a>
      <a href="/TermsAndConditions">Terms</a>
      <a href="/PrivacyPolicy">Privacy Policy</a>
    </div>
    <div class="footer-brand-admin">
      <a href="/" class="footer-brand">
        <Logo className="scale-50" />
      </a>
      <LoginButton client:load />
    </div>
  </footer>
</div>
<style>
  ul {
    padding: 0;
    margin: 0;
  }

  li {
    margin: 0.75rem 0;
  }

  a {
    display: inline-block;
    padding: 0.25rem 0;
  }

  .theme-toggle-wrap {
    padding-top: 0.5rem;
  }

  .footer-brand-admin {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  a.footer-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    font-family: "Montserrat", sans-serif;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
</style>
