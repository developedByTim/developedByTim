---
import FullMenu from "./FullMenu.astro";
const { pathname } = Astro.url;
---

<header>
<nav class="toolbar-nav items-center p-4 md:p-10 lg:p-16 xl:p-20">
    <div class="brand-clock">
      <a href="/" class="brand-name">DEVELOPED BY TIM</a>
      <time id="nz-time" class="nz-clock" aria-label="Current time in New Zealand">
        --:-- (GMT+00:00)
      </time>
    </div>
    <div class="main-links flex items-center gap-20 relative">
      <a
        href="/MovingImages"
        class={`link ${pathname === "/MovingImages" ? "active" : ""}`}
        >Cinema</a
      >
      <a href="/Photography" class={`link ${pathname === "/Photography" ? "active" : ""}`}>Gallery</a>
    </div>
    <div class="toolbar-actions flex items-center gap-4 md:gap-8 relative">
       <a
        href="https://www.youtube.com/@developedbytim"
        target="_blank"
        rel="noreferrer"
        aria-label="Youtube"
        class="fa fa-youtube social-link"
      ></a>
      <a
        href="https://www.instagram.com/developedbytim/"
        target="_blank"
        rel="noreferrer"
        aria-label="Instagram"
        class="fa fa-instagram social-link"
      ></a>
      <div id="burgerMenu" class="burgerBtn flex items-center">
        <span class="burger"></span>
      </div>
      <div id="fullMenu">
        <FullMenu />
      </div>
    </div>
  </nav>
</header>

<style>
  header {
    position: relative;
    z-index: 4000;
  }

  .toolbar-nav {
    display: flex;
    justify-content: space-between;
  }

  .brand-clock {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
  }

  .fa {
    font-size: 2rem;
  }

  .social-link {
    color: var(--text);
    line-height: 1;
  }

  .social-link:hover {
    opacity: 0.7;
  }

  .nz-clock {
    color: var(--text);
    font-family: "Montserrat", sans-serif;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    white-space: nowrap;
  }
 
  .brand-name {
    color: var(--text);
    font-family: "Montserrat", sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }
 
  .burger {
    width: 2rem;
    height: 4px;
    background-color: var(--text);
    position: relative;
  }
  .burger::before {
    content: "";
    width: 2rem;
    height: 4px;
    background-color: var(--text);
    position: absolute;
    top: -8px;
    left: 0;
  }
  .burger::after {
    content: "";
    width: 2rem;
    height: 4px;
    background-color: var(--text);
    position: absolute;
    bottom: -8px;
    left: 0;
  }
  .burgerBtn {
    height: 20px;
  }
  .burgerBtn:hover {
    cursor: pointer;
  }
  #fullMenu {
    position: absolute;
    top: 130%;
    right: 0;
    opacity: 0;
    transform: scale(0);
    transform-origin: top right;
    transition: ease 0.25s;
    z-index: 4100;
  }
  
  #fullMenu.show {
    opacity: 1;
    transform: scale(1);
  }
.link {
  position: relative;
  text-transform: uppercase;
  font-size: 1.5rem;
  font-weight: 800;
  font-family: "Montserrat", sans-serif;
  padding: 0.5rem 1rem;
  transition: letter-spacing 0.25s ease, opacity 0.25s ease;
}
.link {
  display: inline-block;
  transition: transform 0.2s ease;
}

.link:hover {
  transform: translateY(-2px);
}

.link.active {
  transform: translateY(-2px);
    background:var(--panel);
}

 
/* Dark mode tweak */
:root[data-theme="dark"] .link.active {
  background: var(--panel-selected);
}
   @media (max-width: 768px) {
  .toolbar-nav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "brand actions";
    column-gap: 1rem;
  }

  .brand-clock {
    grid-area: brand;
  }

  .main-links {
    display: none;
  }

  .toolbar-actions .social-link {
    display: none;
  }

  .toolbar-actions {
    grid-area: actions;
  }

  #fullMenu {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;

        width: 100vw;
        height: 100vh;

        transform: translateY(-130%);
        opacity: 1;
        transform-origin: top;
 
        padding: 4rem 2rem;

        transition: transform 0.3s ease;
    }

    #fullMenu.show {
        transform: translateY(0);
    }
}
@media (max-width: 380px) {
  .toolbar-actions {
    gap: 0.75rem;
  }
}
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const nzClock = document.getElementById("nz-time");
    const nzTimeFormatter = new Intl.DateTimeFormat("en-NZ", {
      timeZone: "Pacific/Auckland",
      hour: "2-digit",
      minute: "2-digit",
      hourCycle: "h23",
    });
    const nzOffsetFormatter = new Intl.DateTimeFormat("en-NZ", {
      timeZone: "Pacific/Auckland",
      timeZoneName: "longOffset",
    });

    const updateNzClock = () => {
      if (!nzClock) return;
      const now = new Date();
      const offset = nzOffsetFormatter
        .formatToParts(now)
        .find((part) => part.type === "timeZoneName")?.value;

      nzClock.textContent = `${nzTimeFormatter.format(now)} (${offset ?? "NZ time"})`;
      nzClock.setAttribute("datetime", now.toISOString());
    };

    updateNzClock();
    window.setInterval(updateNzClock, 1000);

    const closeMenuBtn = document.getElementById("closeMenu");
    const burgerMenuBtn = document.getElementById("burgerMenu");
    const fullMenu = document.getElementById("fullMenu");
    const body = document.body; // Get the body element

    // Open/close the menu when burger button is clicked
    burgerMenuBtn?.addEventListener("click", (event) => {
      event.stopPropagation(); // Prevent click event from propagating to body
      burgerMenuBtn.classList.toggle("active");
      fullMenu?.classList.toggle("show");
    });
closeMenuBtn?.addEventListener("click", (event) => {
  event.stopPropagation();
  fullMenu?.classList.remove("show");
  burgerMenuBtn?.classList.remove("active");
});
    // Close the menu if clicking outside the menu
    body.addEventListener("click", (event) => {
      // Type assertion to ensure event.target is of type Node
      const target = event.target as Node;

      if (
        fullMenu?.classList.contains("show") &&
        fullMenu &&
        !fullMenu.contains(target) &&
        !burgerMenuBtn?.contains(target)
      ) {
        fullMenu.classList.remove("show");
        burgerMenuBtn?.classList.remove("active");
      }
    });

    // Prevent the body click event from closing the menu when clicking inside the full menu
    fullMenu?.addEventListener("click", (event) => {
      event.stopPropagation();
    });
  });
</script>
